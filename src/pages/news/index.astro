---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { withBase } from '../../lib/withBase';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(posts.flatMap((p) => p.data.categories))]
  .filter(Boolean)
  .sort();
---

<BaseLayout title="News" description="News and updates from Federated Auto Parts.">
  <section class="page-hero angled centered">
    <div class="container">
      <h1>Federated News</h1>
      <p>Announcements, member stories, awards, and industry updates.</p>
    </div>
  </section>

  <section class="section news-section">
    <div class="container">
      <form class="news-search" action={withBase('/news/')} method="get" role="search">
        <label class="sr-only" for="news-q">Search news</label>
        <input id="news-q" type="search" name="q" placeholder="Search Here" />
        <button type="submit" aria-label="Search">Search</button>
      </form>

      {
        categories.length > 0 && (
          <div class="category-chips" aria-label="News categories">
            <a class="chip chip-active" href={withBase('/news/')}>All</a>
            {categories.slice(0, 12).map((cat) => (
              <a class="chip" href={withBase(`/news/category/${cat}/`)}>
                {cat.replace(/-/g, ' ')}
              </a>
            ))}
          </div>
        )
      }
      {
        posts.length === 0 ? (
          <p>No news posts yet.</p>
        ) : (
          <div class="card-grid">
            {posts.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .news-section {
    padding-top: 0.5rem;
  }
</style>
