---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (entry) => {
    const { id, data } = entry;
    if (data.draft) return false;
    if (data.template === 'home') return false;
    // WP home is pages/index.md; glob id follows frontmatter slug (federated-auto-parts)
    const filePath = 'filePath' in entry ? String(entry.filePath ?? '') : '';
    if (
      id === 'index' ||
      id === 'federated-auto-parts' ||
      data.slug === 'home' ||
      data.slug === 'index' ||
      data.slug === 'federated-auto-parts' ||
      filePath.endsWith('/index.md') ||
      filePath.endsWith('pages/index.md')
    ) {
      return false;
    }
    return true;
  });

  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const looksLegal =
  page.data.template === 'legal' ||
  /terms|privacy|legal|cookie|disclaimer/i.test(page.data.slug);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  legal={looksLegal}
>
  <section class="page-hero">
    <div class="container">
      <h1>{page.data.title}</h1>
      {page.data.description && <p>{page.data.description}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
