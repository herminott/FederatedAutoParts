---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/withBase';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (entry) => {
    const { id, data } = entry;
    if (data.draft) return false;
    if (data.template === 'home') return false;
    // Dedicated routes (not generic collection pages)
    if (
      id === 'quality-parts' ||
      data.slug === 'quality-parts' ||
      id === 'contact' ||
      data.slug === 'contact' ||
      id === 'find-a-store' ||
      data.slug === 'find-a-store'
    ) {
      return false;
    }
    const filePath = 'filePath' in entry ? String(entry.filePath ?? '') : '';
    if (
      id === 'index' ||
      id === 'federated-auto-parts' ||
      data.slug === 'home' ||
      data.slug === 'index' ||
      data.slug === 'federated-auto-parts' ||
      filePath.endsWith('/index.md') ||
      filePath.endsWith('pages/index.md')
    ) {
      return false;
    }
    return true;
  });

  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const looksLegal =
  page.data.template === 'legal' ||
  /terms|privacy|legal|cookie|disclaimer/i.test(page.data.slug);

const featured = page.data.featuredImage ? withBase(page.data.featuredImage) : null;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  legal={looksLegal}
>
  <section class="page-hero">
    <div class="container">
      <h1>{page.data.title}</h1>
      {page.data.description && <p>{page.data.description}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        featured && !looksLegal && (
          <figure class="page-featured">
            <img src={featured} alt="" width="1120" height="480" />
          </figure>
        )
      }
      <article class:list={['prose', { 'prose-wide': !looksLegal, 'prose-legal': looksLegal }]}>
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .page-featured {
    margin: 0 0 2rem;
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    background: var(--color-gray-100);
    max-width: 920px;
  }

  .page-featured img {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
  }
</style>
