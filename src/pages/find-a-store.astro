---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Find a Store"
  description="Find a Federated Auto Parts store near you. Store locator coming soon."
>
  <section class="page-hero">
    <div class="container">
      <h1>Find a Store</h1>
      <p>Locate an independently owned Federated Auto Parts store in your area.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="coming-soon">
        <h2>Store locator coming soon</h2>
        <p>
          We are rebuilding the store finder for this new static site. In the
          meantime, contact your local Federated distributor or check back soon.
        </p>
        <p style="margin-top: 1.5rem;">
          <a class="btn btn-primary" href="/about-federated/">Learn about Federated</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
