---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { withBase } from '../lib/withBase';

const allPosts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = allPosts[0];
const posts = allPosts.slice(0, 6);

const featuredImage = featured?.data.featuredImage
  ? withBase(featured.data.featuredImage)
  : withBase('/media/brand/about-federated.jpg');
const featuredDate = featured
  ? featured.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const props = [
  {
    badge: 'Membership',
    title: 'Partner with Federated',
    text: 'Independent distributors gain national buying power, brand access, and programs while staying locally owned.',
    href: '/federated-membership/',
    image: '/media/uploads/2023/08/Membership.jpg',
  },
  {
    badge: 'Quality Parts',
    title: 'Parts professionals trust',
    text: 'Broad coverage across undercar, underhood, brakes, filters, and more from trusted manufacturers.',
    href: '/quality-parts/',
    image: '/media/brand/federatedgoldlogo.png',
  },
  {
    badge: 'Distribution',
    title: 'Dependable delivery',
    text: 'A network built to get the right part to the counter and the bay when shops need it.',
    href: '/dependable-distribution/',
    image: '/media/uploads/2023/08/DependableDistribution.jpg',
  },
  {
    badge: 'Training & News',
    title: 'Stay sharp, stay informed',
    text: 'Professional training resources and news from across the Federated family of companies.',
    href: '/news/',
    image: '/media/brand/federated40years.jpg',
  },
];
---

<BaseLayout
  title="Home"
  description="Federated Auto Parts connects independent distributors with quality automotive parts, programs, and local support."
>
  {
    featured && (
      <section class="section home-feature-wrap">
        <div class="container">
          <article class="home-feature">
            <a class="home-feature-media" href={withBase(`/news/${featured.data.slug}/`)}>
              <img src={featuredImage} alt="" width="720" height="480" />
            </a>
            <div class="home-feature-body">
              <h1>
                <a href={withBase(`/news/${featured.data.slug}/`)}>{featured.data.title}</a>
              </h1>
              <p class="home-feature-date">
                <time datetime={featured.data.pubDate.toISOString()}>{featuredDate}</time>
              </p>
              <p class="home-feature-excerpt">{featured.data.description}</p>
              <p>
                <a class="read-release" href={withBase(`/news/${featured.data.slug}/`)}>
                  Read Release →
                </a>
              </p>
              {
                featured.data.categories.length > 0 && (
                  <p class="home-feature-tags">
                    {featured.data.categories.map((c) => c.replace(/-/g, ' ')).join(', ')}
                  </p>
                )
              }
              <div class="home-feature-actions">
                <a class="btn btn-primary" href={withBase('/find-a-store/')}>Find a Store</a>
                <a class="btn btn-outline" href={withBase('/about-federated/')}>About Federated</a>
                <a class="btn btn-outline" href={withBase('/news/')}>Latest News</a>
              </div>
            </div>
          </article>
        </div>
      </section>
    )
  }

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Why Federated</h2>
        <p>
          Membership, quality parts, dependable distribution, and training — the same
          pillars featured across the Federated network.
        </p>
      </div>
      <div class="value-grid">
        {
          props.map((item) => (
            <a class="value-card" href={withBase(item.href)}>
              <div class="value-card-media">
                <img src={withBase(item.image)} alt="" loading="lazy" width="480" height="270" />
              </div>
              <div class="value-card-body">
                <span class="badge">{item.badge}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <span class="read-more">Learn more →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header section-header-row">
        <div>
          <h2>Latest news</h2>
          <p>Updates from across the Federated network.</p>
        </div>
        <a class="btn btn-outline" href={withBase('/news/')}>View all news</a>
      </div>
      <div class="card-grid">
        {posts.map((post) => <NewsCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Need parts nearby?</h2>
      <p>Locate a Federated Auto Parts store and get the right part the first time.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase('/find-a-store/')}>Find a Store</a>
        <a class="btn btn-secondary" href={withBase('/federated-headquarters/')}>Contact Headquarters</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-feature-wrap {
    padding-top: 2.25rem;
    padding-bottom: 1rem;
    background:
      radial-gradient(circle at 10% 0%, rgba(0, 97, 170, 0.06), transparent 40%),
      var(--color-white);
  }

  .home-feature {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 0;
    border-radius: calc(var(--radius) + 4px);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
    background: var(--color-white);
    box-shadow: var(--shadow);
  }

  .home-feature-media {
    display: block;
    min-height: 320px;
    background: var(--color-blue);
  }

  .home-feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-feature-body {
    padding: 1.75rem 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .home-feature-body h1 {
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    margin: 0;
  }

  .home-feature-body h1 a {
    color: var(--color-blue);
    text-decoration: none;
  }

  .home-feature-body h1 a:hover {
    color: var(--color-orange);
  }

  .home-feature-date {
    margin: 0;
    color: var(--color-gray-500);
    font-size: 0.95rem;
  }

  .home-feature-excerpt {
    margin: 0;
    color: var(--color-gray-700);
    flex: 1;
  }

  .read-release {
    color: var(--color-orange);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .read-release:hover {
    color: var(--color-orange-dark);
  }

  .home-feature-tags {
    margin: 0.35rem 0 0;
    color: var(--color-gray-400);
    font-size: 0.85rem;
    text-transform: capitalize;
  }

  .home-feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .value-card {
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
    height: 100%;
  }

  .value-card:hover {
    border-color: var(--color-orange);
    box-shadow: 0 14px 32px rgba(0, 97, 170, 0.14);
    transform: translateY(-2px);
  }

  .value-card-media {
    aspect-ratio: 16 / 9;
    background: var(--color-blue);
    overflow: hidden;
  }

  .value-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .value-card-body {
    padding: 1.25rem 1.35rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .value-card-body h3 {
    margin: 0;
  }

  .value-card-body p {
    margin: 0;
    color: var(--color-gray-700);
    flex: 1;
  }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-header-row .btn {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 860px) {
    .home-feature {
      grid-template-columns: 1fr;
    }

    .home-feature-media {
      min-height: 220px;
      aspect-ratio: 16 / 10;
    }

    .value-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
