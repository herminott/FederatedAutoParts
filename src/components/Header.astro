---
import { withBase } from '../lib/withBase';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

type NavChild = { href: string; label: string; external?: boolean };
type NavItem = {
  href?: string;
  label: string;
  children?: NavChild[];
};

/** Primary IA matches live WP top labels/order. */
const nav: NavItem[] = [
  {
    label: 'Federated Auto Parts',
    href: withBase('/about-federated/'),
    children: [
      { href: withBase('/federated-membership/'), label: 'Federated Membership' },
      { href: withBase('/about-federated/'), label: 'About Federated' },
      { href: withBase('/our-history-of-success/'), label: 'Our History of Success' },
      { href: withBase('/dependable-distribution/'), label: 'Dependable Distribution' },
      { href: withBase('/guarantee-programs/'), label: 'Guarantee Programs' },
      { href: withBase('/quality-parts/'), label: 'Quality Parts' },
    ],
  },
  { href: withBase('/quality-parts/'), label: 'Quality Parts' },
  {
    label: 'News',
    href: withBase('/news/'),
    children: [
      { href: withBase('/news/'), label: 'Federated News' },
      { href: withBase('/news/category/contests-promotions/'), label: 'Contests & Promotions' },
      { href: withBase('/news/category/corporate-events/'), label: 'Corporate Events' },
      { href: withBase('/news/category/motorsports/'), label: 'Motorsports' },
      { href: withBase('/news/category/the-group/'), label: 'The Group' },
    ],
  },
  {
    label: 'Awards',
    href: withBase('/news/category/federated-awards/'),
    children: [
      { href: withBase('/news/category/federated-awards/'), label: 'Federated Awards' },
      { href: withBase('/news/category/scholarships/'), label: 'Scholarships' },
      { href: withBase('/vendor-hall-of-fame/'), label: 'Vendor Hall of Fame' },
    ],
  },
  {
    label: 'Resources',
    children: [
      { href: 'https://www.federatedcc.com/', label: 'Federated Car Care', external: true },
      { href: 'http://federatedlink.com', label: 'Federated Link', external: true },
      { href: 'https://thegrouptrainingacademy.com/', label: 'Training Academy', external: true },
      { href: withBase('/online-resources/'), label: 'Online Resources' },
      { href: withBase('/professional-training/'), label: 'Professional Training' },
    ],
  },
  {
    label: 'Contact',
    href: withBase('/federated-headquarters/'),
    children: [
      { href: withBase('/federated-headquarters/'), label: 'Federated Headquarters' },
      { href: withBase('/find-a-store/'), label: 'Local Federated Stores' },
      { href: 'https://www.federatedcc.com/locations.html', label: 'Local Car Care Centers', external: true },
    ],
  },
];

function isActive(href?: string, children?: NavChild[]) {
  const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
  if (href) {
    if (href === base || href === withBase('/')) {
      return normalized === base || pathname === base.replace(/\/$/, '');
    }
    if (normalized === href || normalized.startsWith(href)) return true;
  }
  return Boolean(
    children?.some((c) => !c.external && (normalized === c.href || normalized.startsWith(c.href))),
  );
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={base}>
      <img
        src={withBase('/media/brand/federated-logo.png')}
        alt="Federated Auto Parts"
        width="180"
        height="48"
      />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      id="nav-toggle"
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item, index) => (
            <li class:list={['nav-item', { 'has-dropdown': item.children?.length }]}>
              {index > 0 && <span class="nav-pipe" aria-hidden="true">|</span>}
              {item.children?.length ? (
                <>
                  {item.href ? (
                    <a
                      href={item.href}
                      class:list={['nav-link', { active: isActive(item.href, item.children) }]}
                      aria-haspopup="true"
                    >
                      {item.label}
                    </a>
                  ) : (
                    <button
                      type="button"
                      class:list={['nav-link', 'nav-button', { active: isActive(undefined, item.children) }]}
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      {item.label}
                    </button>
                  )}
                  <ul class="dropdown" aria-label={`${item.label} submenu`}>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class={isActive(child.href) ? 'active' : undefined}
                          target={child.external ? '_blank' : undefined}
                          rel={child.external ? 'noopener noreferrer' : undefined}
                        >
                          {child.label}
                          {child.external && <span class="ext" aria-hidden="true">↗</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    color: var(--color-gray-700);
    min-height: var(--header-h);
    border-bottom: 1px solid var(--color-gray-200);
    box-shadow: 0 2px 10px rgba(0, 97, 170, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    position: relative;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo img {
    display: block;
    height: 52px;
    width: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-pipe {
    color: var(--color-gray-400);
    margin: 0 0.15rem;
    font-weight: 400;
    user-select: none;
  }

  .nav-link,
  .nav-button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.45rem 0.55rem;
    color: var(--color-gray-700);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.82rem;
    border-radius: 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-button:hover {
    color: var(--color-blue);
    background: var(--color-blue-soft);
  }

  .nav-link.active,
  .nav-button.active {
    color: var(--color-white);
    background: var(--color-blue);
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 250px;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: 10px;
    box-shadow: 0 16px 36px rgba(0, 97, 170, 0.14);
    z-index: 20;
  }

  .nav-item:hover > .dropdown,
  .nav-item:focus-within > .dropdown,
  .nav-item.open > .dropdown {
    display: block;
  }

  .dropdown a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    color: var(--color-gray-700);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 600;
    border-radius: 6px;
  }

  .dropdown a:hover,
  .dropdown a.active {
    background: var(--color-blue-soft);
    color: var(--color-blue);
  }

  .ext {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-gray-200);
    border-radius: 8px;
    background: var(--color-white);
    padding: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-blue);
  }

  @media (max-width: 1100px) {
    .nav-link,
    .nav-button {
      font-size: 0.75rem;
      padding: 0.4rem 0.4rem;
    }
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: var(--header-h);
      background: var(--color-white);
      border-top: 1px solid var(--color-gray-200);
      border-bottom: 1px solid var(--color-gray-200);
      padding: 0.75rem 1rem 1.25rem;
      max-height: calc(100vh - var(--header-h));
      overflow: auto;
      box-shadow: 0 12px 28px rgba(0, 97, 170, 0.12);
    }

    .primary-nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
    }

    .nav-item {
      display: block;
    }

    .nav-pipe {
      display: none;
    }

    .nav-link,
    .nav-button {
      width: 100%;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border-radius: 8px;
      font-size: 0.92rem;
    }

    .dropdown {
      position: static;
      display: none;
      min-width: 0;
      margin: 0.15rem 0 0.35rem;
      box-shadow: none;
      border: 0;
      background: var(--color-off-white);
    }

    .nav-item.open > .dropdown {
      display: block;
    }

    .nav-item:hover > .dropdown,
    .nav-item:focus-within > .dropdown {
      display: none;
    }

    .nav-item.open:hover > .dropdown,
    .nav-item.open:focus-within > .dropdown {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav.querySelectorAll('.has-dropdown > .nav-link, .has-dropdown > .nav-button').forEach((el) => {
      el.addEventListener('click', (event) => {
        if (window.matchMedia('(max-width: 980px)').matches) {
          const parent = el.closest('.nav-item');
          if (!parent) return;
          if (el.tagName === 'A' && parent.classList.contains('open')) return;
          event.preventDefault();
          parent.classList.toggle('open');
          if (el instanceof HTMLButtonElement) {
            el.setAttribute('aria-expanded', String(parent.classList.contains('open')));
          }
        }
      });
    });
  }
</script>
