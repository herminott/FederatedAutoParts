---
import { withBase } from '../lib/withBase';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

type NavChild = { href: string; label: string; external?: boolean };
type NavItem = {
  href?: string;
  label: string;
  children?: NavChild[];
};

const nav: NavItem[] = [
  {
    label: 'About',
    href: withBase('/about-federated/'),
    children: [
      { href: withBase('/about-federated/'), label: 'About Federated' },
      { href: withBase('/federated-membership/'), label: 'Membership' },
      { href: withBase('/our-history-of-success/'), label: 'History' },
      { href: withBase('/dependable-distribution/'), label: 'Distribution' },
      { href: withBase('/guarantee-programs/'), label: 'Guarantees' },
      { href: withBase('/quality-parts/'), label: 'Quality Parts' },
    ],
  },
  {
    label: 'News',
    href: withBase('/news/'),
    children: [
      { href: withBase('/news/'), label: 'All News' },
      { href: withBase('/news/category/contests-promotions/'), label: 'Contests & Promotions' },
      { href: withBase('/news/category/corporate-events/'), label: 'Corporate Events' },
      { href: withBase('/news/category/motorsports/'), label: 'Motorsports' },
      { href: withBase('/news/category/the-group/'), label: 'The Group' },
      { href: withBase('/news/category/federated-awards/'), label: 'Awards' },
      { href: withBase('/news/category/scholarships/'), label: 'Scholarships' },
      { href: withBase('/vendor-hall-of-fame/'), label: 'Vendor Hall of Fame' },
    ],
  },
  {
    label: 'Resources',
    children: [
      { href: 'https://www.federatedcc.com/', label: 'Federated Car Care', external: true },
      { href: 'http://federatedlink.com', label: 'Federated Link', external: true },
      { href: 'https://thegrouptrainingacademy.com/', label: 'Training Academy', external: true },
      { href: withBase('/online-resources/'), label: 'Online Resources' },
      { href: withBase('/professional-training/'), label: 'Professional Training' },
    ],
  },
  { href: withBase('/federated-headquarters/'), label: 'Headquarters' },
  { href: withBase('/find-a-store/'), label: 'Find a Store' },
];

function isActive(href?: string, children?: NavChild[]) {
  const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
  if (href) {
    if (href === base || href === withBase('/')) {
      return normalized === base || pathname === base.replace(/\/$/, '');
    }
    if (normalized === href || normalized.startsWith(href)) return true;
  }
  return Boolean(children?.some((c) => !c.external && (normalized === c.href || normalized.startsWith(c.href))));
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={base}>
      <img src={withBase('/media/brand/federated-logo.png')} alt="Federated Auto Parts" width="160" height="40" />
      <span class="logo-text">Federated Auto Parts</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      id="nav-toggle"
    >
      <span class="sr-only">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li class:list={['nav-item', { 'has-dropdown': item.children?.length }]}>
              {item.children?.length ? (
                <>
                  {item.href ? (
                    <a
                      href={item.href}
                      class:list={['nav-link', { active: isActive(item.href, item.children) }]}
                      aria-haspopup="true"
                    >
                      {item.label}
                      <span class="caret" aria-hidden="true" />
                    </a>
                  ) : (
                    <button
                      type="button"
                      class:list={['nav-link', 'nav-button', { active: isActive(undefined, item.children) }]}
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      {item.label}
                      <span class="caret" aria-hidden="true" />
                    </button>
                  )}
                  <ul class="dropdown" aria-label={`${item.label} submenu`}>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class={isActive(child.href) ? 'active' : undefined}
                          target={child.external ? '_blank' : undefined}
                          rel={child.external ? 'noopener noreferrer' : undefined}
                        >
                          {child.label}
                          {child.external && <span class="ext" aria-hidden="true">↗</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-navy);
    color: var(--color-white);
    min-height: var(--header-h);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    position: relative;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .logo img {
    display: block;
    height: 36px;
    width: auto;
  }

  .logo:hover {
    color: #ffd7dc;
  }

  @media (max-width: 640px) {
    .logo-text {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link,
  .nav-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.75rem;
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-button:hover,
  .nav-link.active,
  .nav-button.active {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
  }

  .nav-link.active,
  .nav-button.active {
    box-shadow: inset 0 -2px 0 var(--color-red);
    border-radius: 0;
  }

  .caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    opacity: 0.75;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 240px;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: var(--color-navy-deep);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  .nav-item:hover > .dropdown,
  .nav-item:focus-within > .dropdown,
  .nav-item.open > .dropdown {
    display: block;
  }

  .dropdown a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 600;
    border-radius: 6px;
  }

  .dropdown a:hover,
  .dropdown a.active {
    background: rgba(200, 16, 46, 0.22);
    color: var(--color-white);
  }

  .ext {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    background: transparent;
    padding: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-white);
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: inline-flex;
    }

    .primary-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: var(--header-h);
      background: var(--color-navy-deep);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.75rem 1rem 1.25rem;
      max-height: calc(100vh - var(--header-h));
      overflow: auto;
    }

    .primary-nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
    }

    .nav-link,
    .nav-button {
      width: 100%;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border-radius: 8px;
    }

    .nav-link.active,
    .nav-button.active {
      border-radius: 8px;
      box-shadow: none;
      background: rgba(200, 16, 46, 0.25);
    }

    .dropdown {
      position: static;
      display: none;
      min-width: 0;
      margin: 0.15rem 0 0.35rem;
      box-shadow: none;
      border: 0;
      background: rgba(0, 0, 0, 0.2);
    }

    .nav-item.open > .dropdown {
      display: block;
    }

    .nav-item:hover > .dropdown,
    .nav-item:focus-within > .dropdown {
      display: none;
    }

    .nav-item.open:hover > .dropdown,
    .nav-item.open:focus-within > .dropdown {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    nav.querySelectorAll('.has-dropdown > .nav-link, .has-dropdown > .nav-button').forEach((el) => {
      el.addEventListener('click', (event) => {
        if (window.matchMedia('(max-width: 980px)').matches) {
          const parent = el.closest('.nav-item');
          if (!parent) return;
          // Allow direct navigation for links only when already open
          if (el.tagName === 'A' && parent.classList.contains('open')) return;
          event.preventDefault();
          parent.classList.toggle('open');
          if (el instanceof HTMLButtonElement) {
            el.setAttribute('aria-expanded', String(parent.classList.contains('open')));
          }
        }
      });
    });
  }
</script>
