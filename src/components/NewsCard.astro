---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/withBase';

interface Props {
  post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const href = withBase(`/news/${post.data.slug}/`);
const date = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const image = post.data.featuredImage ? withBase(post.data.featuredImage) : null;
const category = post.data.categories[0];
const searchText = [
  post.data.title,
  post.data.description,
  ...post.data.categories,
  ...post.data.tags,
]
  .filter(Boolean)
  .join(' ');
---

<article class="news-card" data-search={searchText}>
  <a href={href} class="news-card-link">
    <div class="news-card-media">
      {
        image ? (
          <img src={image} alt="" loading="lazy" width="640" height="360" />
        ) : (
          <div class="news-card-placeholder" aria-hidden="true" />
        )
      }
    </div>
    <div class="news-card-body">
      {
        category && (
          <span class="badge">{category.replace(/-/g, ' ')}</span>
        )
      }
      <h3>{post.data.title}</h3>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      </p>
      <p class="excerpt">{post.data.description}</p>
      <span class="read-more">Read more →</span>
    </div>
  </a>
</article>
