---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">Federated Auto Parts</p>
      <p class="footer-blurb">
        Supporting independent auto parts distributors with quality brands,
        programs, and local expertise.
      </p>
    </div>
    <div>
      <p class="footer-heading">Explore</p>
      <ul>
        <li><a href="/about-federated/">About</a></li>
        <li><a href="/news/">News</a></li>
        <li><a href="/find-a-store/">Find a Store</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-heading">Legal</p>
      <ul>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms-of-use/">Terms of Use</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Federated Auto Parts. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-deep);
    color: rgba(255, 255, 255, 0.85);
    padding: 3rem 0 1.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-white);
    margin: 0 0 0.75rem;
  }

  .footer-blurb {
    margin: 0;
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 0.75rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer li + li {
    margin-top: 0.4rem;
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: #ffd7dc;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1rem;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
