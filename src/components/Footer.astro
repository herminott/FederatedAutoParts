---
import { withBase } from '../lib/withBase';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-stats">
    <article class="stat-card">
      <h3>Hundreds of Warehouses</h3>
      <p>Over 150 warehouse distribution centers nationwide allows us to get parts to you fast!</p>
    </article>
    <article class="stat-card">
      <h3>Thousands of Locations</h3>
      <p>Supporting thousands of Federated locations, providing quality name brand parts.</p>
    </article>
    <article class="stat-card">
      <h3>Millions of Catalog Parts</h3>
      <p>Over 1.4 million SKUs in our online catalog system. We have the parts you need.</p>
    </article>
  </div>

  <div class="footer-tagline">
    <div class="container">
      <p>
        Providing world class distribution, marketing tools and reliable auto parts and
        accessories for over 30 years!
      </p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      &copy; {year} Federated Auto Parts
      <span aria-hidden="true"> | </span>
      <a href={withBase('/terms-and-conditions/')}>Terms &amp; Conditions</a>
      <span aria-hidden="true"> | </span>
      <a href={withBase('/privacy-policy/')}>Privacy Policy</a>
    </p>
    <p class="footer-links">
      <a href={withBase('/contact/')}>Contact</a>
      <a href={withBase('/federated-headquarters/')}>Headquarters</a>
      <a href={withBase('/find-a-store/')}>Find a Store</a>
      <a href={withBase('/news/')}>News</a>
      <a href={withBase('/about-federated/')}>About</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-off-white);
    color: var(--color-gray-700);
    margin-top: auto;
    border-top: 1px solid var(--color-gray-200);
  }

  .footer-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 3rem 0 2rem;
  }

  .stat-card {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius);
    padding: 1.35rem 1.4rem;
    box-shadow: var(--shadow);
  }

  .stat-card h3 {
    margin: 0 0 0.55rem;
    font-size: 1.05rem;
    color: var(--color-blue);
  }

  .stat-card p {
    margin: 0;
    color: var(--color-gray-700);
    font-size: 0.95rem;
  }

  .footer-tagline {
    background: var(--color-blue);
    color: var(--color-white);
    padding: 1.5rem 0;
    text-align: center;
  }

  .footer-tagline p {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.45;
    max-width: 52rem;
    margin-inline: auto;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1.1rem 0 1.35rem;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-gray-500);
  }

  .footer-bottom a {
    color: var(--color-blue);
    text-decoration: none;
    font-weight: 600;
  }

  .footer-bottom a:hover {
    color: var(--color-orange);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.1rem;
  }

  @media (max-width: 800px) {
    .footer-stats {
      grid-template-columns: 1fr;
      padding-top: 2rem;
    }
  }
</style>
